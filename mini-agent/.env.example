# 复制为 .env 后填写本地值；.env 已被 .gitignore 忽略，不要提交真实凭据
# 任意 OpenAI-compatible 服务的根地址（通常以 /v1 结尾）
LLM_BASE_URL=https://api.openai.com/v1
# 模型服务的 API Key（留空则 CLI 启动时直接提示退出）
LLM_API_KEY=
# 模型名
LLM_MODEL=gpt-4o-mini
# 单次模型调用超时（毫秒，可选，默认 60000）
LLM_TIMEOUT_MS=60000
# 用量落盘路径（可选；设为 1 表示默认 .agent-usage.json，留空则只在内存累计）
AGENT_USAGE_FILE=
# token 预算上限（可选；累计 totalTokens 达到后在下一次调模型前停止）
AGENT_BUDGET_TOKENS=
